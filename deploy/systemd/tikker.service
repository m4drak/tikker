#
# systemd unit for the tikker binary (docs/deploy-server.md).
# Install: cp tikker.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now tikker
# Configuration: /etc/tikker/tikker.env (mode 0600; may hold TIKKER_ADMIN_PASSWORD / TIKKER_SECRET_KEY).
# Data: /var/lib/tikker (StateDirectory) with tikker.db and secret.key - back both up together.

[Unit]
Description=tikker SMS gateway for MikroTik
Documentation=https://github.com/m4drak/tikker
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/tikker serve
EnvironmentFile=/etc/tikker/tikker.env
Environment=TIKKER_DATA_DIR=/var/lib/tikker
Environment=TIKKER_LISTEN=127.0.0.1:8080
Restart=on-failure
RestartSec=5s
# TIKKER_SHUTDOWN_TIMEOUT defaults to 30s; leave systemd a margin.
TimeoutStopSec=45s

# Identity and state
DynamicUser=yes
StateDirectory=tikker
StateDirectoryMode=0700
UMask=0077

# Resource limits (RSS at rest ~40 MB, SPEC 2.2)
MemoryMax=256M
Environment=GOMEMLIMIT=96MiB
TasksMax=128

# Hardening
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
